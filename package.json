{
  "name": "jewelry-b2b-global",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "test": "vitest run",
    "workers:dev": "wrangler dev -c dist/server/wrangler.json",
    "db:init": "wrangler d1 execute jewelry-b2b-global-db --local --persist-to .wrangler/state --file=infra/schema.sql",
    "db:init:remote": "wrangler d1 execute jewelry-b2b-global-db --remote --file=infra/schema.sql",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.0",
    "@iconify-json/lucide": "1.2.138",
    "@nanostores/persistent": "1.3.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "nanostores": "^1.5.4",
    "resend": "6.31.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.125.0"
  }
}
