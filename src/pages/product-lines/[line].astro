---
// src/pages/product-lines/[line].astro — 产品线 Landing
//
// 本页职责被压缩成三件事：**取数 → 建 ViewModel → 把 Props 递给区块组件**。
// 所有「钢线长什么样、合金线长什么样」的差异都由 line-aggregation 的计算结果决定，
// 页面里没有一处 `line === 'xxx' ? A : B`。
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import {
  getProducts,
  byLine,
  toSkuIndexItem,
  getActiveLines,
  heroImageOfLine,
} from '../../lib/products/queries';
import { buildLineViewModel, categoryGridClass } from '../../lib/products/line-aggregation';
import { catalogUrl } from '../../lib/products/deeplink';
import { lineLabel, rfqNoteUrl } from '../../lib/products/lines';
import { organizationJsonld, collectionPageJsonld, breadcrumbJsonld } from '../../lib/seo/jsonld';
import { getSiteUrl } from '../../lib/seo/site';
import LineHero from '../../components/product-line/LineHero.astro';
import LineStatsBar from '../../components/product-line/LineStatsBar.astro';
import LineAnchorNav from '../../components/product-line/LineAnchorNav.astro';
import LineFacts from '../../components/product-line/LineFacts.astro';
import LineStyleChips from '../../components/product-line/LineStyleChips.astro';
import LineCategoryGrid from '../../components/product-line/LineCategoryGrid.astro';
import LineProductRail from '../../components/product-line/LineProductRail.astro';
import LineCtaBand from '../../components/product-line/LineCtaBand.astro';
import LineOtherLines from '../../components/product-line/LineOtherLines.astro';

export async function getStaticPaths() {
  // 只为有公开产品的产品线生成静态页——空线（如未来补货前）不生成路由，补货后自动恢复。
  const lines = await getActiveLines();
  return lines.map((entry) => ({ params: { line: entry.data.line }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'productLines'>;
}
const { entry } = Astro.props as Props;
const { line, name, icon, lineToken, tagline, position, facts } = entry.data;
const { Content } = await render(entry);

const all = await getProducts();
const publicItems = (slug: string) => byLine(all, slug).filter((it) => it.data.dataStatus === 'real');
const vm = buildLineViewModel({ line, name, items: publicItems(line) });

const site = getSiteUrl(Astro.site);
const path = `/product-lines/${line}/`;
const lineHref = catalogUrl({ line });
const rfqHref = rfqNoteUrl(line, name);

/** 另一条产品线（线卡形态：线名 + tagline + SKU 数 + View line） */
const otherCards = (await getActiveLines())
  .filter((other) => other.data.line !== line)
  .map((other) => ({
    name: lineLabel(other.data.line) || other.data.name,
    tagline: other.data.tagline,
    count: t('home.categories.count', { count: publicItems(other.data.line).length }),
    href: `/product-lines/${other.data.line}/`,
    image: heroImageOfLine(all, other.data.line),
    line: other.data.line,
  }));

// 注意：BaseLayout 的 jsonld 是默认参数、**传入即覆盖**：数组第一项必须显式带上 Organization，
// 否则这一页会丢掉站点级实体描述。
const jsonld = [
  organizationJsonld(site),
  collectionPageJsonld({ site, path, name, description: tagline, numberOfItems: vm.skuCount }),
  breadcrumbJsonld(site, vm.breadcrumb),
];

const stats = [
  { icon: 'package', text: t('line.stats.skus', { count: vm.skuCount }) },
  { icon: 'shapes', text: t('line.stats.families', { types: vm.typeCount, styles: vm.familyCount }) },
  { icon: 'file-check', text: t('line.stats.confirm') },
];
const anchors = [
  { id: 'overview', label: t('line.nav.overview') },
  { id: 'styles', label: t('line.nav.styles') },
  { id: 'types', label: t('line.nav.types') },
  { id: 'gallery', label: t('line.nav.gallery') },
];
---

<BaseLayout title={name} description={tagline} path={path} jsonld={jsonld}>
  <LineHero
    line={line}
    name={name}
    icon={icon}
    lineToken={lineToken}
    tagline={tagline}
    breadcrumb={vm.breadcrumb}
    heroImage={heroImageOfLine(all, line)}
    heroCategory={vm.categories[0]?.value ?? 'bracelet'}
    catalogHref={lineHref}
    rfqHref={rfqHref}
  />
  <LineStatsBar items={stats} />
  <LineAnchorNav anchors={anchors} rfqHref={rfqHref} />
  <LineFacts title={t('line.position.title')} position={position} facts={facts} />
  <LineStyleChips
    line={line}
    forms={vm.styleForms}
    motifs={vm.styleMotifs}
    untaggedCount={vm.untaggedCount}
    catalogHref={lineHref}
  />
  <LineCategoryGrid line={line} categories={vm.categories} gridClass={categoryGridClass(vm.typeCount)} />
  <LineProductRail
    title={t('line.gallery.title')}
    note={t('line.gallery.note')}
    items={vm.picks.map(toSkuIndexItem)}
    gridClass={vm.railGridClass}
    wrapperMaxW={vm.railWrapperMaxW}
    sizes={vm.railSizes}
    viewAllHref={lineHref}
    viewAllLabel={t('line.viewAllSkus', { count: vm.skuCount })}
  />
  <LineCtaBand
    title={t('line.ctaBand.title')}
    body={t('line.ctaBand.body')}
    primaryHref={rfqHref}
    primaryLabel={t('cta.startRfq')}
    secondaryHref={lineHref}
    secondaryLabel={t('cta.browseCatalog')}
  />

  {/* 材质工艺正文：从原来的第 3 屏后移。买家的动线是「这条线是什么 → 有多少货 →
      看图 → 询价 → 才需要读工艺」，把 4 屏工艺长文前置，是把它给了还没决定要看货的人。 */}
  <section class="mx-auto max-w-3xl section-y scroll-mt-20 pt-0 lg:scroll-mt-[7.5rem]">
    <h2 class="text-xl font-semibold text-fg">{t('line.materials.title')}</h2>
    <div class="mt-6 grid gap-4 text-base leading-relaxed text-fg-2 [&_h2]:mt-6 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-fg [&_li]:ml-5 [&_li]:list-disc [&_ul]:grid [&_ul]:gap-1.5">
      <Content />
    </div>
    <a href="/compliance/nickel-release-en-1811/" class="mt-6 inline-flex h-11 items-center gap-1 text-sm font-medium text-accent hover:underline">
      {t('cta.howWeTest')}
      <Icon name="lucide:arrow-right" class="icon size-4" aria-hidden="true" />
    </a>
  </section>

  <LineOtherLines
    title={t('line.otherLines.title')}
    viewLabel={t('line.otherLines.view')}
    cards={otherCards}
  />
</BaseLayout>
