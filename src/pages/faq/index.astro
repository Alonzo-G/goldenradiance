---
// src/pages/faq/index.astro — FAQ 分组 accordion + 顶部搜索（JSON-LD FAQPage）
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import { faqPageJsonld } from '../../lib/seo/jsonld';

const entries = await getCollection('pages', (e) => e.id === 'faq');
const data = entries[0]?.data;
const groups = (data?.groups ?? []).map((g) => ({
  id: g.id,
  title: t(`faq.group.${g.id}` as 'faq.group.moq'),
  questions: g.questions,
}));
---

<BaseLayout
  title={t('faq.title')}
  description={t('compliance.batch.body')}
  path="/faq/"
  jsonld={[faqPageJsonld(groups)]}
>
  <div class="mx-auto max-w-3xl py-10">
    <h1 class="text-2xl font-semibold text-fg">{t('faq.title')}</h1>
    <div class="mt-6 flex items-center gap-2 rounded-sm border border-border bg-surface px-3">
      <Icon name="lucide:search" class="icon size-5 text-muted" aria-hidden="true" />
      <input
        data-faq-search
        type="search"
        placeholder={t('faq.searchPlaceholder')}
        class="h-12 w-full bg-transparent text-sm text-fg outline-none placeholder:text-meta"
        aria-label={t('faq.title')}
      />
    </div>

    <div class="mt-8 grid gap-8" data-faq-groups>
      {groups.map((g) => (
        <section data-faq-group={g.id}>
          <h2 class="text-lg font-semibold text-fg">{g.title}</h2>
          <div class="mt-3">
            {g.questions.map((qa) => (
              <details class="group border-b border-border-soft py-3" data-faq-item>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-fg [&::-webkit-details-marker]:hidden">
                  <span>{qa.q}</span>
                  <Icon name="lucide:chevron-down" class="icon size-4 shrink-0 text-muted transition-transform group-open:rotate-180" aria-hidden="true" />
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-muted">{qa.a}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
      <p data-faq-empty hidden class="text-sm text-muted">{t('blog.empty')}</p>
    </div>

    <div class="mt-10 rounded-md border border-border bg-surface p-5 text-center">
      <p class="text-sm text-fg-2">{t('faq.unresolved')}</p>
      <a href="/contact/" class="mt-3 inline-flex h-11 items-center rounded-sm border border-accent px-4 text-sm font-medium text-accent hover:bg-surface-sunken">
        {t('faq.contactCta')}
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n';

  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const groups = document.querySelectorAll<HTMLElement>('[data-faq-group]');
  const emptyNote = document.querySelector<HTMLElement>('[data-faq-empty]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visibleTotal = 0;
    groups.forEach((group) => {
      let visibleInGroup = 0;
      group.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
        const match = !q || item.textContent?.toLowerCase().includes(q);
        item.toggleAttribute('hidden', !match);
        if (match) visibleInGroup += 1;
      });
      group.toggleAttribute('hidden', visibleInGroup === 0);
      visibleTotal += visibleInGroup;
    });
    if (emptyNote) {
      emptyNote.textContent = t('search.noResults');
      emptyNote.toggleAttribute('hidden', visibleTotal > 0);
    }
  });
</script>
