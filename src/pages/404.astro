---
// src/pages/404.astro — 自定义 404（noindex + 不进 Pagefind 索引）
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';

const lines = [
  { href: '/product-lines/fashion-alloy-brass/', label: t('nav.line.alloy') },
  { href: '/product-lines/stainless-titanium-steel/', label: t('nav.line.steel') },
  { href: '/product-lines/natural-stone-gemstone-pearl/', label: t('nav.line.stone') },
];
---

<BaseLayout
  title={t('notFound.title')}
  description={t('notFound.body')}
  path="/404/"
  noindex
  pagefind={false}
>
  <div class="mx-auto flex max-w-2xl flex-col items-center py-16 text-center sm:py-24">
    <span class="caps text-xs font-semibold text-accent-metal">{t('notFound.eyebrow')}</span>
    <h1 class="mt-3 text-3xl font-semibold text-fg">{t('notFound.title')}</h1>
    <p class="mt-3 max-w-lg text-md text-muted">{t('notFound.body')}</p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/products/"
        class="flex h-12 items-center justify-center rounded-sm bg-accent px-6 text-sm font-medium text-accent-on hover:bg-accent-hover"
      >
        {t('notFound.browseCatalog')}
      </a>
      <button
        type="button"
        data-search-open
        class="flex h-12 items-center justify-center gap-2 rounded-sm border border-border bg-surface px-6 text-sm font-medium text-fg hover:bg-surface-sunken"
      >
        <Icon name="lucide:search" class="icon size-5 text-muted" aria-hidden="true" />
        {t('search.title')}
      </button>
    </div>

    <p class="mt-4 text-sm text-meta">{t('notFound.searchHint')}</p>

    <div class="mt-10 w-full border-t border-border pt-8">
      <p class="caps text-xs font-semibold text-meta">{t('notFound.browseLines')}</p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-3">
        {lines.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex h-11 items-center justify-center rounded-sm border border-border bg-surface px-4 text-sm font-medium text-fg hover:bg-surface-sunken"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 w-full rounded-md border border-border bg-surface-sunken p-6 text-left">
      <p class="text-base font-semibold text-fg">{t('notFound.rfqTitle')}</p>
      <p class="mt-1 text-sm text-fg-2">{t('notFound.rfqBody')}</p>
      <div class="mt-4 flex gap-4">
        <a href="/rfq/" class="text-sm font-medium text-accent hover:underline">{t('cta.startRfq')}</a>
        <a href="/contact/" class="text-sm font-medium text-accent hover:underline">{t('cta.contactUs')}</a>
      </div>
    </div>
  </div>
</BaseLayout>
