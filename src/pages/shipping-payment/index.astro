---
// src/pages/shipping-payment/index.astro — 物流与付款（数字未确认走降级）
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

const entries = await getCollection('pages', (e) => e.id === 'shipping-payment');
const entry = entries[0];
const { Content } = entry ? await render(entry) : { Content: null };
---

<BaseLayout title={t('shipping.title')} description={t('shipping.moq.body')} path="/shipping-payment/">
  <div class="mx-auto max-w-3xl py-10">
    <h1 class="text-2xl font-semibold text-fg">{t('shipping.title')}</h1>
    {Content && (
      <div class="mt-8 grid gap-4 text-base leading-relaxed text-fg-2 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-fg [&_li]:ml-5 [&_li]:list-disc [&_ul]:grid [&_ul]:gap-1.5">
        <Content />
      </div>
    )}
  </div>
</BaseLayout>
