---
// src/pages/sourcing-partners/index.astro — 合作产线与质控（AC-24/25/26：诚实定位，禁工厂宣称）
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';

const entries = await getCollection('pages', (e) => e.id === 'sourcing-partners');
const entry = entries[0];
const { Content } = entry ? await render(entry) : { Content: null };
---

<BaseLayout title={t('sourcing.title')} description={t('sourcing.intro')} path="/sourcing-partners/">
  <div class="mx-auto max-w-3xl py-10">
    <h1 class="text-2xl font-semibold text-fg">{t('sourcing.title')}</h1>
    <p class="mt-4 border-l-2 border-accent pl-4 text-md leading-relaxed text-fg-2">{t('sourcing.intro')}</p>

    {Content && (
      <div class="mt-8 grid gap-4 text-base leading-relaxed text-fg-2 [&_h2]:mt-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-fg [&_li]:ml-5 [&_li]:list-disc [&_ul]:grid [&_ul]:gap-1.5">
        <Content />
      </div>
    )}

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-fg">{t('sourcing.qc.title')}</h2>
      <ol class="mt-5 grid gap-4">
        {[t('sourcing.qc.step1'), t('sourcing.qc.step2'), t('sourcing.qc.step3')].map((step, i) => (
          <li class="flex items-start gap-4 rounded-md border border-border bg-surface p-4 shadow-raised">
            <Icon name={i === 0 ? 'lucide:package-search' : i === 1 ? 'lucide:search' : 'lucide:truck'} class="icon mt-0.5 size-5 text-accent" aria-hidden="true" />
            <p class="text-sm text-fg-2">{step}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-fg">{t('sourcing.buyers.title')}</h2>
      <p class="mt-3 text-sm text-fg-2">{t('sourcing.buyers.body')}</p>
    </section>

    <div class="mt-10 border-t border-border pt-6">
      <a href="/rfq/" class="flex h-12 w-full items-center justify-center rounded-sm bg-accent-metal text-sm font-medium text-metal-on hover:bg-accent-metal-hover sm:w-64">
        {t('cta.startRfq')}
      </a>
    </div>
  </div>
</BaseLayout>
