---
// src/pages/compliance/nickel-release-en-1811.astro — 镍释放子专题（AC-20 长文教学 + 限值表）
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { blogPostingJsonld } from '../../lib/seo/jsonld';
import { getSiteUrl } from '../../lib/seo/site';

const entries = await getCollection('compliance');
const entry = entries[0];
const { Content } = entry ? await render(entry) : { Content: null };
const site = getSiteUrl(Astro.site);
---

<BaseLayout
  title={entry?.data.title ?? t('compliance.nickelArticle.title')}
  description={entry?.data.description ?? ''}
  path="/compliance/nickel-release-en-1811/"
  ogType="article"
  jsonld={[
    blogPostingJsonld({
      site,
      path: '/compliance/nickel-release-en-1811/',
      headline: entry?.data.title ?? 'Nickel release & EN 1811, explained',
      description: entry?.data.description ?? '',
      datePublished: new Date(),
    }),
  ]}
>
  <article class="mx-auto max-w-3xl py-10">
    <h1 class="text-2xl font-semibold text-fg">{t('compliance.nickelArticle.title')}</h1>
    <p class="mt-4 border-l-2 border-accent pl-4 text-md leading-relaxed text-fg-2">{t('compliance.nickelArticle.intro')}</p>

    {/* 限值表（教育口径；AC-40：穿刺类 0.2） */}
    <section class="mt-8 rounded-md border border-border bg-surface-sunken p-5">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="caps py-2 text-xs font-medium text-muted">Article type</th>
            <th class="caps py-2 text-right text-xs font-medium text-muted">Limit (µg/cm²/week)</th>
          </tr>
        </thead>
        <tbody class="tnum">
          <tr class="border-b border-border-soft">
            <td class="py-2.5 text-fg-2">Coated articles (after EN 12472 wear simulation)</td>
            <td class="py-2.5 text-right font-semibold text-fg">0.5</td>
          </tr>
          <tr>
            <td class="py-2.5 text-fg-2">Pierced articles — ear posts and similar</td>
            <td class="py-2.5 text-right font-semibold text-fg">0.2</td>
          </tr>
        </tbody>
      </table>
      <p class="mt-3 text-xs text-meta">{t('compliance.nickelArticle.limitCoated')}</p>
      <p class="mt-1 text-xs text-meta">{t('compliance.nickelArticle.limitPierced')}</p>
    </section>

    {Content && (
      <div class="mt-8 grid gap-4 text-base leading-relaxed text-fg-2 [&_h2]:mt-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-fg [&_h3]:mt-4 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-fg [&_li]:ml-5 [&_li]:list-disc [&_ul]:grid [&_ul]:gap-1.5 [&_ol]:grid [&_ol]:gap-1.5 [&_ol>li]:ml-5 [&_ol>li]:list-decimal">
        <Content />
      </div>
    )}

    <div class="mt-10 border-t border-border pt-6">
      <a href="/rfq/" class="flex h-12 w-full items-center justify-center rounded-sm bg-accent-metal text-sm font-medium text-metal-on hover:bg-accent-metal-hover sm:w-64">
        {t('cta.startRfq')}
      </a>
    </div>
  </article>
</BaseLayout>
