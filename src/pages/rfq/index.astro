---
// src/pages/rfq/index.astro — RFQ 询价篮独立页（抽屉同内容；便于书签/邮件回跳）
import BaseLayout from '../../layouts/BaseLayout.astro';
import RfqPanel from '../../components/rfq/RfqPanel.astro';
import { t } from '../../i18n';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title={t('rfq.title')} description={t('rfq.summary.degraded')} path="/rfq/" hideMobileContact>
  <div class="mx-auto max-w-2xl py-10">
    <h1 class="text-2xl font-semibold text-fg">{t('rfq.title')}</h1>
    <p data-rfq-total class="tnum mt-1 text-sm text-meta">{t('rfq.total', { count: 0, pcs: 0 })}</p>
    <div class="mt-6 rounded-lg border border-border bg-surface p-6 shadow-raised">
      <RfqPanel panelId="page" />
    </div>
    <p class="mt-4 flex items-start gap-2 text-xs text-muted">
      <Icon name="lucide:shield-check" class="icon mt-0.5 size-4 shrink-0" aria-hidden="true" />
      {t('rfq.summary.degraded')}
    </p>
  </div>
</BaseLayout>
