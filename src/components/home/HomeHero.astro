---
// src/components/home/HomeHero.astro — 非对称两栏 Hero（UIUX §12[2]）
// 三张产品线卡优先展示各线视觉最强的真实实拍图（dataStatus real + 有主图），
// 缺图时才回落程序化占位图——首屏即真实货，降低「货还没上」的误判跳出。
// 文案只用已确认量级/区间，禁精确数字。
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import ProductImage from '../product/ProductImage.astro';
import { getProducts, getActiveLines } from '../../lib/products/queries';

const products = await getProducts();
const activeLines = await getActiveLines();

const LINE_STRIP: Record<string, { label: string; note: string; cat: string }> = {
  'fashion-alloy-brass': { label: 'Fashion Alloy & Brass', note: 'Zinc alloy & brass, plated', cat: 'earrings' },
  'stainless-titanium-steel': { label: 'Stainless & Titanium Steel', note: '316L / titanium · PVD plating', cat: 'necklace' },
  'natural-stone-gemstone-pearl': { label: 'Natural Stone, Gem & Pearl', note: 'By lot: no two stones alike', cat: 'bracelet' },
};

const strips = activeLines.map((entry) => ({
  line: entry.data.line,
  ...(LINE_STRIP[entry.data.line] ?? { label: entry.data.name, note: '', cat: 'ring' }),
}));

/** 每条线选 1 款「视觉最强」的真实产品：优先有实拍图 + 图多 + 风格标签丰富，否则回落占位图。 */
const heroImageFor = (line: string) => {
  const pool = products
    .filter((p) => p.data.line === line && p.data.dataStatus === 'real' && p.data.images?.length)
    .sort(
      (a, b) =>
        (b.data.images?.length ?? 0) - (a.data.images?.length ?? 0) ||
        (b.data.style_tags?.length ?? 0) - (a.data.style_tags?.length ?? 0),
    );
  const pick = pool[0];
  if (!pick) return null;
  const img = pick.data.images![0];
  return {
    src: img.src,
    thumb: img.thumb,
    alt: img.alt || pick.data.title,
    width: img.width,
    height: img.height,
    slug: pick.data.slug,
    title: pick.data.title,
  };
};
---

<section class="section-y">
  <div class={`container-wide grid items-stretch gap-8 lg:grid-cols-[2fr_${strips.map(() => '1fr').join('_')}]`}>
    <div class="flex max-w-xl flex-col justify-center">
      <h1 class="text-3xl font-bold text-fg">{t('hero.h1')}</h1>
      <p class="mt-4 text-md text-muted">{t('hero.line2')}</p>
      <p class="mt-2 text-base text-fg-2">{t('hero.line3')}</p>
      <p class="tnum mt-4 text-sm font-medium text-fg">{t('hero.dataLine')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/products/" class="flex h-12 items-center rounded-sm bg-accent-metal px-5 text-sm font-medium text-metal-on transition-colors duration-150 hover:bg-accent-metal-hover">
          {t('cta.browseCatalog')}
        </a>
        <a href="/rfq/" class="flex h-12 items-center rounded-sm border border-accent px-5 text-sm font-medium text-accent transition-colors duration-150 hover:bg-surface-sunken">
          {t('cta.startRfq')}
        </a>
      </div>
    </div>
    {strips.map((s) => {
      const hero = heroImageFor(s.line);
      return (
        <a href={hero ? `/products/${hero.slug}/` : `/product-lines/${s.line}/`} class="group flex flex-col gap-3">
          <div class="grid flex-1 gap-3">
            <ProductImage
              image={hero ? { src: hero.src, thumb: hero.thumb, alt: hero.alt, width: hero.width, height: hero.height } : null}
              category={s.cat}
              line={s.line}
              label={s.label}
              ratio="4:5"
              alt=""
              loading="eager"
              fetchpriority="high"
              class="min-h-40"
            />
          </div>
          <div class="border-l-2 border-[var(--color-line-alloy)] pl-3" style={`border-color: var(--color-${s.line})`}>
            <h2 class="text-sm font-semibold text-fg">{s.label}</h2>
            <p class="mt-0.5 text-xs text-muted">{s.note}</p>
            <p class="mt-1 flex items-center gap-1 text-xs font-medium text-accent group-hover:underline">
              {t('cta.viewAll')}
              <Icon name="lucide:arrow-right" class="icon size-4" aria-hidden="true" />
            </p>
          </div>
        </a>
      );
    })}
  </div>
</section>