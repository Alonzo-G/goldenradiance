---
// src/components/home/HomeLines.astro — 产品线 Bento + 深墨玉信任条（AC-42 五项）
// 视觉与 Hero 统一：每条线用真实实拍代表图（queries.heroImageForLine），
// 缺图时才回落程序化占位图——同一屏不允许「真实图 vs 占位图」混排。
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import ProductImage from '../product/ProductImage.astro';
import { getActiveLines, getProducts, heroImageForLine } from '../../lib/products/queries';

const LINE_META: Record<string, { label: string; desc: string; token: string; icon: string; cat: string }> = {
  'fashion-alloy-brass': { label: t('nav.line.alloy'), desc: t('home.lines.alloy.desc'), token: 'line-alloy', icon: 'anvil', cat: 'ring' },
  'stainless-titanium-steel': { label: t('nav.line.steel'), desc: t('home.lines.steel.desc'), token: 'line-steel', icon: 'droplets', cat: 'necklace' },
};

const [products, activeLines] = await Promise.all([getProducts(), getActiveLines()]);
// 第一条活跃线默认「大卡」，其余小卡；仅一条活跃线时也走大卡
const lines = activeLines.map((entry, idx) => {
  const meta = LINE_META[entry.data.line] ?? { label: entry.data.name, desc: '', token: 'line-alloy', icon: 'anvil', cat: 'ring' };
  return {
    id: entry.data.line,
    ...meta,
    big: idx === 0,
    hero: heroImageForLine(products, entry.data.line),
  };
});

const trust = [
  { icon: 'ruler', label: t('trust.1.label'), desc: t('trust.1.desc') },
  { icon: 'package-search', label: t('trust.2.label'), desc: t('trust.2.desc') },
  { icon: 'file-check', label: t('trust.3.label'), desc: t('trust.3.desc') },
  { icon: 'globe', label: t('trust.4.label'), desc: t('trust.4.desc') },
  { icon: 'clock', label: t('trust.5.label'), desc: t('trust.5.desc') },
];
---

<section class="section-y">
  <div class="container-wide">
    <h2 class="text-2xl font-semibold text-fg">{t('home.lines.title')}</h2>
    <div class="mt-6 grid gap-6 lg:grid-cols-[2fr_1fr]">
      {lines.map((l) => (
        <a
          href={`/product-lines/${l.id}/`}
          class:list={['group flex flex-col overflow-hidden rounded-md border border-border bg-surface shadow-raised', l.big && 'lg:row-span-1']}
        >
          <ProductImage
            image={l.hero ? { src: l.hero.src, thumb: l.hero.thumb, alt: l.hero.alt, width: l.hero.width, height: l.hero.height } : null}
            category={l.cat}
            line={l.id}
            label={l.label}
            ratio={l.big ? '16:9' : '4:5'}
            alt=""
          />
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center gap-2">
              <Icon name={`lucide:${l.icon}`} class="icon size-5" aria-hidden="true" />
              <h3 class="text-lg font-semibold text-fg">{l.label}</h3>
            </div>
            <p class="mt-2 flex-1 text-sm text-muted">{l.desc}</p>
            <p class="mt-3 text-sm font-medium text-accent group-hover:underline">{t('cta.viewAll')}</p>
            <div class="mt-3 h-0.5 w-full" style={`background: var(--color-${l.token})`} aria-hidden="true"></div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="bg-surface-inverse py-12 text-fg-inverse">
  <div class="container-wide grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
    {trust.map((item) => (
      <div>
        <Icon name={`lucide:${item.icon}`} class="icon size-6" aria-hidden="true" />
        <p class="caps mt-3 text-xs font-medium">{item.label}</p>
        <p class="mt-1 text-sm text-fg-inverse/80">{item.desc}</p>
      </div>
    ))}
  </div>
</section>
