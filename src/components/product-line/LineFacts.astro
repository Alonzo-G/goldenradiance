---
// src/components/product-line/LineFacts.astro — 一句话定位 + 若干事实（分隔栏，无编号）
//
// 编号 01/02/03 去掉：这些事实是并列关系，编号会诱导买家按顺序读，
// 还会隐含「重要性递减」的意思。改成竖线分隔栏，视觉上就是一组平列事实。
//
// position / facts 都来自内容集合 frontmatter，不再按线名走 i18n 编号 key ——
// 那正是「把钢线的 bangle/cuff/chain 卖点贴到合金线页」这类事实错误的温床。
interface Props {
  title: string;
  position: string;
  facts: string[];
}
const { title, position, facts } = Astro.props;
---

<section id="overview" class="section-y scroll-mt-20 lg:scroll-mt-[7.5rem]">
  <div class="container-wide">
    <h2 class="caps text-xs text-muted">{title}</h2>
    <p class="mt-3 text-xl font-semibold text-fg">{position}</p>
    <ul class="mt-6 grid gap-6 md:grid-cols-3 md:gap-0">
      {
        facts.map((fact, i) => (
          <li class:list={['text-sm leading-relaxed text-fg-2', i > 0 && 'md:border-l md:border-border md:pl-6']}>
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>
