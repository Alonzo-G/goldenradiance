---
// src/components/product-line/LineStatsBar.astro —「 At a glance 」事实条
//
// 三格全部由数据算出（线内 SKU 数 / 品类数 · 款式族数 / 未确认字段的措辞），
// 不再是两条线复用同一句「Catalogue depth varies by line」——那句等于没说。
//
// 第三格**不写** MOQ 数字：MOQ 数值属客户未确认数据（OD-04），到位前对外一律
// 只写「confirmed with your quotation」，连站点级范围档也不写——它不是本线的已确认值。
// 本线的数字必须随报价确认，写成具体档次就是我们自己制造下一次 MOQ 诚实性问题。
import { Icon } from 'astro-icon/components';

export interface LineStat {
  /** Lucide 图标名（不含 `lucide:` 前缀） */
  icon: string;
  text: string;
}

interface Props {
  items: LineStat[];
}
const { items } = Astro.props;
---

{
  /* 数据驱动隐藏：一条都没有就整块不渲染，不留空标题、不留「coming soon」占位 */
  items.length > 0 && (
    <section class="border-b border-border bg-surface">
      <div class="container-wide grid gap-4 py-6 sm:grid-cols-3 sm:gap-6">
        {items.map((item) => (
          <p class="flex items-start gap-2 text-sm text-fg-2">
            <Icon name={`lucide:${item.icon}`} class="icon mt-0.5 size-4 shrink-0 text-meta" aria-hidden="true" />
            <span>{item.text}</span>
          </p>
        ))}
      </div>
    </section>
  )
}
