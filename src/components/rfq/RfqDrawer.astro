---
// src/components/rfq/RfqDrawer.astro — 桌面右侧抽屉 420px / 移动全屏 sheet（UIUX §8.2）
// 纯遮罩（--overlay），无 blur；Esc 关闭 + 焦点归还。
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import RfqPanel from './RfqPanel.astro';
---

<div data-rfq-overlay hidden class="fixed inset-0 z-[400] bg-overlay"></div>
<aside
  data-rfq-drawer
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={t('rfq.title')}
  class="fixed inset-x-0 bottom-0 z-[410] flex max-h-[92dvh] flex-col rounded-t-2xl bg-surface shadow-[0_-8px_32px_rgb(20_24_28/0.12)] will-change-transform md:inset-y-0 md:inset-x-auto md:right-0 md:max-h-none md:w-[420px] md:rounded-none md:shadow-drawer"
>
  {/* 移动端拖拽 handle（下滑关闭手势锚点），桌面隐藏 */}
  <div data-rfq-handle class="flex shrink-0 justify-center pb-1 pt-2 md:hidden" aria-hidden="true">
    <span class="h-1.5 w-10 rounded-pill bg-border"></span>
  </div>
  <div class="flex items-center justify-between border-b border-border px-5 py-4">
    <div>
      <h2 class="text-lg font-semibold text-fg">{t('rfq.title')}</h2>
      <p data-rfq-total class="tnum text-xs text-meta">{t('rfq.total', { count: 0, pcs: 0 })}</p>
    </div>
    <button
      type="button"
      data-rfq-close
      class="flex size-11 items-center justify-center rounded-sm text-fg hover:bg-surface-sunken"
    >
      <Icon name="lucide:x" class="icon size-5" aria-hidden="true" />
      <span class="sr-only">{t('nav.closeMenu')}</span>
    </button>
  </div>
  <div data-rfq-body class="flex-1 overflow-y-auto px-5 py-4">
    <RfqPanel panelId="drawer" />
  </div>
  <div class="sticky bottom-0 border-t border-border bg-surface px-5 py-4">
    <button type="button" data-rfq-close class="h-10 w-full text-sm text-muted hover:text-fg">
      {t('rfq.continue')}
    </button>
  </div>
</aside>
