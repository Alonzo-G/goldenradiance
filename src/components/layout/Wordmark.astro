---
// src/components/layout/Wordmark.astro — 品牌字标占位（CONTENT-PLACEHOLDER-PLAN §5）
// 纯文字两重量 lockup；真实 logo 到位后只改此文件。
import { cn } from '../../lib/shared/format';

interface Props {
  variant?: 'header' | 'footer' | 'compact';
  class?: string;
}
const { variant = 'header', class: cls } = Astro.props;
const isFooter = variant === 'footer';
const isCompact = variant === 'compact';
---

{
  isCompact ? (
    <span
      class={cn(
        'caps font-display text-xs font-semibold',
        isFooter ? 'text-fg-inverse' : 'text-fg',
        cls,
      )}
    >
      Golden Radiance
    </span>
  ) : (
    <span
      class={cn(
        'font-display text-base sm:text-lg',
        isFooter ? 'text-fg-inverse' : 'text-fg',
        cls,
      )}
      style="letter-spacing: 0.01em"
    >
      <span class="font-bold">Golden</span>{' '}
      <span class="font-normal">Radiance</span>
    </span>
  )
}
