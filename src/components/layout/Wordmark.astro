---
// src/components/layout/Wordmark.astro — 品牌 logo + 字标 lockup
// glyph 源：logo-full-glyph.png（透明底金色 G 星），经 scripts/gen-brand-assets.mjs 适配 128px。
// 图为装饰性（旁有品牌文字），alt 留空避免读屏重复。
// 注意：Astro frontmatter 是纯 TS 区域，不能写 JSX 字面量——img 必须内联在模板里。
import { cn } from '../../lib/shared/format';

interface Props {
  variant?: 'header' | 'footer' | 'compact';
  class?: string;
}
const { variant = 'header', class: cls } = Astro.props;
const isFooter = variant === 'footer';
const isCompact = variant === 'compact';
---

{
  isCompact ? (
    <span
      class={cn(
        'caps font-display text-xs font-semibold',
        isFooter ? 'text-fg-inverse' : 'text-fg',
        cls,
      )}
    >
      Golden Radiance
    </span>
  ) : (
    <span class={cn('flex items-center gap-2', cls)}>
      <img
        src="/logo-glyph.png"
        alt=""
        width="128"
        height="128"
        class="size-8 shrink-0 sm:size-9"
        loading="eager"
        decoding="async"
      />
      <span
        class={cn(
          'font-display text-base sm:text-lg',
          isFooter ? 'text-fg-inverse' : 'text-fg',
          // 极窄屏（<360px）隐藏字标只留 glyph。实测 320px 视口下：
          // 字标约 130px + glyph 32px + 右侧按钮簇 148px + 容器 padding 32px = 溢出 23px。
          // 375px 起有富余，故断点取 359px。页脚纵向空间充足，不受影响。
          !isFooter && 'max-[359px]:hidden',
        )}
        style="letter-spacing: 0.01em"
      >
        <span class="font-bold">Golden</span>{' '}
        <span class="font-normal">Radiance</span>
      </span>
    </span>
  )
}
