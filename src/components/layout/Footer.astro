---
// src/components/layout/Footer.astro — 4 列 + 合规行 + newsletter（POST /api/v1/newsletter）
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();

const cols = [
  {
    title: t('footer.col.lines'),
    links: [
      { href: '/product-lines/fashion-alloy-brass/', label: t('nav.line.alloy') },
      { href: '/product-lines/stainless-titanium-steel/', label: t('nav.line.steel') },
      { href: '/product-lines/natural-stone-gemstone-pearl/', label: t('nav.line.stone') },
      { href: '/products/', label: t('nav.allProducts') },
    ],
  },
  {
    title: t('footer.col.support'),
    links: [
      { href: '/compliance/', label: t('nav.compliance') },
      { href: '/compliance/nickel-release-en-1811/', label: 'Nickel release (EN 1811)' },
      { href: '/samples/', label: t('nav.samples') },
      { href: '/shipping-payment/', label: t('nav.shippingPayment') },
    ],
  },
  {
    title: t('footer.col.company'),
    links: [
      { href: '/sourcing-partners/', label: t('nav.sourcing') },
      { href: '/blog/', label: t('nav.blog') },
      { href: '/faq/', label: t('nav.faq') },
      { href: '/contact/', label: t('nav.contact') },
    ],
  },
];
---

<footer class="bg-surface-inverse text-fg-inverse">
  <div class="container-wide grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    {cols.map((col) => (
      <nav aria-label={col.title}>
        <h2 class="caps mb-4 text-xs text-fg-inverse/70">{col.title}</h2>
        <ul class="grid gap-2.5">
          {col.links.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-fg-inverse hover:underline">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
    <div>
      <h2 class="caps mb-4 text-xs text-fg-inverse/70">{t('footer.col.newsletter')}</h2>
      <form data-newsletter-form class="flex gap-2" novalidate>
        <label class="sr-only" for="newsletter-email">{t('footer.newsletter.placeholder')}</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder={t('footer.newsletter.placeholder')}
          class="h-11 w-full rounded-sm border border-border-inverse bg-transparent px-3 text-sm text-fg-inverse placeholder:text-fg-inverse/50"
        />
        <button
          type="submit"
          class="h-11 shrink-0 rounded-sm bg-accent-metal px-4 text-sm font-medium text-metal-on transition-colors duration-150 hover:bg-accent-metal-hover"
        >
          {t('footer.newsletter.button')}
        </button>
      </form>
      <p data-newsletter-status class="mt-2 hidden text-sm"></p>
    </div>
  </div>
  <div class="border-t border-border-inverse">
    <div class="container-wide flex flex-col items-start justify-between gap-3 py-6 text-xs text-fg-inverse/70 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2">
        <Icon name="lucide:shield-check" class="icon size-4" aria-hidden="true" />
        <span>{t('footer.complianceNote')}</span>
      </div>
      <div class="flex items-center gap-4">
        <Wordmark variant="footer" class="text-base" />
        <p>{t('footer.rights', { year })}</p>
      </div>
    </div>
  </div>
</footer>

<script>
  import { renderTurnstile, TURNSTILE_SITEKEY } from '../../lib/shared/turnstile';
  import { t } from '../../i18n';

  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.email instanceof HTMLInputElement ? form.email.value.trim() : '';
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;
    const ts = await renderTurnstile(document.createElement('div'));
    try {
      const res = await fetch('/api/v1/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          turnstileToken: ts.getToken() ?? TURNSTILE_SITEKEY,
          honeypot: '',
          email,
          locale: 'en',
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
      show(status, t('footer.newsletter.success'), 'text-fg-inverse');
      form.reset();
    } catch {
      show(status, t('footer.newsletter.error'), 'text-fg-inverse');
    }
  });

  function show(el: HTMLElement | null, msg: string, cls: string) {
    if (!el) return;
    el.textContent = msg;
    el.className = `mt-2 text-sm ${cls}`;
    el.classList.remove('hidden');
  }
</script>
