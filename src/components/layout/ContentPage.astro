---
// src/components/layout/ContentPage.astro — 政策类单页通用壳（content 集合 MD 正文渲染）
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

interface Props {
  title: string;
  description?: string;
  path: string;
  entry: { body?: string };
}
const { title, description, path, entry } = Astro.props;
const { Content } = await render(entry as never);
---

<BaseLayout title={title} description={description ?? t('meta.description')} path={path}>
  <article class="mx-auto max-w-3xl py-10" data-pagefind-weight="0.5">
    <h1 class="text-2xl font-semibold text-fg">{title}</h1>
    {description && <p class="mt-2 text-md text-muted">{description}</p>}
    <div class="mt-8 grid gap-4 text-base leading-relaxed text-fg-2 [&_h2]:mt-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-fg [&_h3]:mt-4 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-fg [&_li]:ml-5 [&_li]:list-disc [&_ul]:grid [&_ul]:gap-1.5 [&_ol]:grid [&_ol]:gap-1.5 [&_ol>li]:ml-5 [&_ol>li]:list-decimal">
      <Content />
    </div>
    <div class="mt-10 border-t border-border pt-6">
      <a href="/contact/" class="text-sm font-medium text-accent hover:underline">{t('cta.contactUs')}</a>
    </div>
  </article>
</BaseLayout>
