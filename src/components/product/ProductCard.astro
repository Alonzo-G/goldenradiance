---
// src/components/product/ProductCard.astro — SKU 卡（UIUX §7.2：价格+MOQ 同一视觉单元，P0 必显）
// 真实素材款：显示实拍图 + 「价格随报价」；未确认 MOQ 走降级文案，不冒充数值。
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n';
import { priceRange } from '../../lib/shared/format';
import type { SkuIndexItem } from '../../lib/products/queries';
import ProductImage from './ProductImage.astro';

interface Props {
  item: SkuIndexItem;
  ratio?: '1:1' | '4:5';
  /**
   * 图片 sizes。**必须与所在栅格的列数/限宽同源**：它决定浏览器选哪个 srcset 候选档，
   * 写成估算的 `23vw` 在宽屏会算成远大于实际卡宽的值，浏览器就会白下一个大档。
   */
  sizes?: string;
  /**
   * 角标策略。`auto`（默认）= 沿用全站既有行为；`none` = 不渲染角标。
   * rail 传 none 的理由：1012 款全是 `dataStatus: 'real'`，默认策略下 6 张卡 6 个
   * "New arrival"，信号归零；且 320px 下卡宽约 146px 时，左上 44px checkbox 会与
   * 右上角标相邻到几乎贴住。
   */
  badge?: 'auto' | 'none';
  /**
   * 加购按钮：`hover`（默认，全站既有语言，在 /products/ 与 PDP 已上线）/
   * `always`（常显，用于「先看看真货」的探索场景）。
   * 默认行为不变 —— 要全局改 hover 揭示是另一次改动，不混进来。
   */
  ctaMode?: 'hover' | 'always';
}
const {
  item,
  ratio = '1:1',
  sizes = '(min-width: 1280px) 22vw, (min-width: 640px) 33vw, 50vw',
  badge = 'auto',
  ctaMode = 'hover',
} = Astro.props;

const alwaysCta = ctaMode === 'always';

const hasPrice = item.priceLow != null && item.priceHigh != null;
const specLine = item.spec || t('pdp.spec.pendingStrip');
const altParts = [item.title, item.material, item.plating].filter(Boolean).join(', ');
---

<article class="group relative" data-sku-card={item.sku}>
  <label class="absolute left-2 top-2 z-[2] flex size-11 cursor-pointer items-center justify-center rounded-xs border border-border bg-surface">
    <input
      type="checkbox"
      data-bulk-check
      value={item.sku}
      data-title={item.title}
      data-slug={item.slug}
      data-moq={item.rfqQty}
      class="size-4 accent-[var(--color-accent-metal)]"
      aria-label={`${t('cta.addToRfq')}: ${item.sku}`}
    />
  </label>
  {
    badge === 'auto' && item.dataStatus === 'real' && (
      <span class="absolute right-2 top-2 z-[2] rounded-xs bg-accent px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-accent-on">
        {t('pdp.newArrival')}
      </span>
    )
  }
  <a href={`/products/${item.slug}/`} class="block">
    <ProductImage
      image={item.image}
      category={item.category}
      line={item.line}
      label={item.category}
      ratio={ratio}
      alt={altParts}
      sizes={sizes}
      class="transition-transform duration-150 group-hover:scale-[1.02]"
    />
  </a>
  <p class="mt-3 font-mono text-xs text-meta">{item.sku}</p>
  <h3 class="mt-1 text-sm font-normal leading-snug text-fg">
    <a href={`/products/${item.slug}/`} class="line-clamp-2 hover:underline">{item.title}</a>
  </h3>
  <p class="mt-1 truncate text-xs text-muted">{specLine}</p>
  {/* 价格 + MOQ 组合块（视觉 1 组；限定语必须可见，禁止 tooltip） */}
  <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-border-soft pt-2">
    {
      hasPrice ? (
        <p class="tnum text-base font-semibold text-fg">
          <span class="font-medium">{t('price.prefix')}</span>{' '}
          {priceRange(item.priceLow as number, item.priceHigh as number)}
          <span class="text-xs font-normal text-muted"> {t('price.unit')}</span>
        </p>
      ) : (
        <p class="text-base font-semibold text-fg">{t('pdp.price.onRequest')}</p>
      )
    }
    <span class="h-4 w-px self-center bg-border" aria-hidden="true" />
    <p class="tnum text-sm font-medium text-fg-2">
      {item.moqMin != null ? t('pdp.moq.label', { min: item.moqMin }) : t('pdp.moq.onRequest')}
    </p>
  </div>
  <p class="mt-1 text-xs text-meta">
    {hasPrice ? t('pdp.price.qualifier') : t('pdp.price.onRequestBody')}
  </p>
  <button
    type="button"
    data-add-to-rfq
    data-sku={item.sku}
    data-slug={item.slug}
    data-title={item.title}
    data-moq={item.rfqQty}
    class:list={[
      'mt-2 flex h-11 w-full items-center justify-center gap-2 rounded-sm border border-accent text-sm font-medium text-accent transition-opacity duration-150',
      alwaysCta ? '' : 'lg:opacity-0 lg:focus-visible:opacity-100 lg:group-hover:opacity-100',
    ]}
  >
    <Icon name="lucide:plus" class="icon size-4" aria-hidden="true" />
    <span data-add-label>{t('cta.addToRfq')}</span>
  </button>
</article>
