---
// src/components/product/Gallery.astro — PDP 画廊（横向滑动 + 指示点，§2.3 / §3.3）
// 真实素材款：逐张实拍图，左右滑动切换 + 指示点；无图款：四帧占位图同样滑动浏览。
// 移动端原生手势滑动，桌面端鼠标拖拽/滚轮/左右箭头均可——全端一致。
import { t } from '../../i18n';
import ProductImage from './ProductImage.astro';
import type { ProductData } from '../../lib/products/queries';

interface Props {
  data: ProductData;
  class?: string;
}
const { data, class: cls } = Astro.props;

const realImages = data.images ?? [];
const alt = [data.title, data.base_material_grade, data.plating_method].filter(Boolean).join(', ');

/** 统一成 { id, label, image } 帧结构 */
const frames =
  realImages.length > 0
    ? realImages.map((im, i) => ({
        id: `shot-${i + 1}`,
        label: `${data.title} — view ${i + 1}`,
        image: im,
      }))
    : [
        { id: 'main', label: data.category, image: null },
        { id: 'batch', label: `${data.category} — batch grid`, image: null },
        { id: 'scale', label: `${data.category} — scale`, image: null },
        { id: 'macro', label: `${data.category} — detail`, image: null },
      ];
---

<div class={cls} data-gallery>
  <div
    data-gallery-track
    role="group"
    aria-label={t('pdp.spec.title')}
    tabindex="0"
    class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      frames.map((f, i) => (
        <div data-frame={f.id} class="w-full shrink-0 snap-start">
          <ProductImage
            image={f.image}
            category={data.category}
            line={data.line}
            label={f.label}
            ratio="1:1"
            alt={`${alt}${i > 0 ? ` (${f.id})` : ''}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            sizes="(min-width: 1024px) 48vw, 100vw"
          />
        </div>
      ))
    }
  </div>
  <div class="mt-3 flex justify-center gap-1" role="tablist" aria-label={t('pdp.spec.title')}>
    {
      frames.map((f, i) => (
        <button
          type="button"
          data-dot={f.id}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={t('pdp.gallery.thumb', { n: i + 1, total: frames.length })}
          class="flex size-11 items-center justify-center"
        >
          <span
            data-dot-bar
            class:list={[
              'h-2 rounded-pill transition-all duration-150',
              i === 0 ? 'w-6 bg-accent' : 'w-2 bg-border',
            ]}
          />
        </button>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    const dots = gallery.querySelectorAll<HTMLButtonElement>('[data-dot]');
    if (!track || !dots.length) return;

    const paint = () => {
      const width = track.clientWidth || 1;
      const i = Math.round(track.scrollLeft / width);
      dots.forEach((d, idx) => {
        const active = idx === i;
        d.setAttribute('aria-selected', String(active));
        const bar = d.querySelector<HTMLElement>('[data-dot-bar]');
        if (!bar) return;
        bar.classList.toggle('w-6', active);
        bar.classList.toggle('bg-accent', active);
        bar.classList.toggle('w-2', !active);
        bar.classList.toggle('bg-border', !active);
      });
    };

    track.addEventListener('scroll', paint, { passive: true });
    window.addEventListener('resize', paint);
    dots.forEach((d, idx) => {
      d.addEventListener('click', () => {
        track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
      });
    });
    paint();
  });
</script>
