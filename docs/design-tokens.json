{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$meta": {
    "name": "Jewelry B2B Global",
    "version": "0.5.0-draft",
    "phase": "Phase 1",
    "owner": "颜好看 / UIUX Designer",
    "updated": "2026-10-01",
    "sourceDoc": "docs/UIUX.md",
    "registry": "mixed — Brand register (home / product-line landing / about / resources), Product register (catalog / search / PDP / RFQ / compliance / policies)",
    "axes": {
      "DESIGN_VARIANCE": 6,
      "MOTION_INTENSITY": 3,
      "VISUAL_DENSITY": "3 (brand pages) / 7 (catalog pages)"
    },
    "locked": {
      "icons": "Lucide — 24px canvas, strokeWidth 1.5, sizes 16/20/24 only",
      "fonts": [
        "Archivo (display)",
        "Public Sans (body)",
        "JetBrains Mono (SKU / numerals)",
        "HarmonyOS Sans SC / Noto Sans SC (CN, admin only)"
      ],
      "currency": "USD only in V1 — currency embedded in the price string (USD 3.80-4.60), no switcher",
      "locale": "storefront = en only; admin UI = zh-CN; the two are fully decoupled. URLs carry NO language prefix (ADR-004 /{lang}/ proposal rejected — see UIUX §11). i18n is v2 groundwork only: dictionary file externalised, hreflang=\"x-default\" slot reserved. V1 emits no second-language routes and renders no language switcher (not even disabled).",
      "note": "Do NOT mix a second icon library. Do NOT hardcode colors outside tokens. Do NOT render a disabled EN / USD dropdown.",
      "priceDisplay": {
        "status": "P0 must-show on list cards AND PDP — not optional decoration",
        "format": "USD 3.80-4.60 / pc  next to  MOQ 24 pcs",
        "qualifier": "Reference range — quoted per order  (MUST be visible, not a tooltip)",
        "rationale": "PM research: hidden MOQ / price / lead time is the #1 pain point for overseas wholesale buyers",
        "boundary": "Precise tiered price table (per-band fixed unit price) is NOT rendered on public pages — routed to RFQ instead, preserving negotiation room for the trading-company client",
        "alignment": "Satisfies PRD AC-07: >=3 quantity bands, each showing a unit price RANGE, never a fixed price"
      },
      "numerals": "All prices / MOQ / dimensions / weight use tabular-nums (Public Sans native tabular figures). Currency prefix is always the 3-letter code \"USD\" so decimal points align vertically across a 1000+ SKU column. JetBrains Mono is reserved for SKU codes and dense numeric identifiers, not measurements."
    },
    "confirmedClientData": {
      "productPhotography": "Several hundred commercially-licensed real product photos, decent quality — unlocks the only P0 blocker (UIUX §17 #9). Requires a client-side usable/reshoot/discard triage pass per UIUX §6.4.",
      "skuScale": "Hundreds of styles — write as magnitude (Hundreds of styles), NOT an exact number",
      "moq": "12-120 pcs per style — write as a range (MOQ 12-120 pcs, stated per style), NOT a single point value",
      "complianceReports": "None held yet; client acknowledges reports can be commissioned later — keep degraded copy (AC-38)",
      "adminLocale": "zh-CN"
    },
    "pendingClientData": [
      "tiered price brackets",
      "per-line typical MOQ bands",
      "real production & shipping lead times",
      "committed RFQ response time",
      "countries / regions covered",
      "logistics methods (DDP / FOB / EXW) & carriers",
      "sample policy",
      "brand CN/EN name, logo, slogan",
      "new-arrival cadence per line"
    ],
    "stack": {
      "framework": "Astro 7.3.5 (static-first, zero JS by default)",
      "styling": "Tailwind CSS 4.3.3 (CSS-first config, @theme token injection)",
      "icons": "astro-icon 1.2.0 + @iconify-json/lucide 1.2.138 (build-time inline, no runtime JS)",
      "state": "Nanostores + @nanostores/persistent 1.3.5 (rfq_v1 / compliance_v1, listen:true)",
      "search": "Pagefind 1.5.2 (extended, CJK segmentation) + SKU dual index",
      "perfBudget": "images long edge <=1200px, WebP/AVIF, LCP <2.5s, CLS <0.1, INP <200ms, no CJK font in EN route bundles"
    }
  },
